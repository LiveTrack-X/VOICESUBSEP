{
  "name": "voicesubsep",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Local speaker-aware subtitle editor",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src && node --test scripts/dev.test.mjs desktop/*.test.cjs",
    "test:watch": "vitest src",
    "start": "node scripts/dev.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:pack": "npm run build && node scripts/desktop-build.mjs pack",
    "desktop:installer": "npm run build && node scripts/desktop-build.mjs installer",
    "desktop:installer:split": "npm run build && node scripts/desktop-build.mjs installer-split",
    "desktop:test": "node --test desktop/*.test.cjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
